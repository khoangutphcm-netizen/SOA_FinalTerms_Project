# Paste the PostgreSQL connection string for each service.
# Keep the TLS options provided by your database host.
IDENTITY_DATABASE_URL=
CONTENT_DATABASE_URL=
COMMERCE_DATABASE_URL=
COMMUNITY_DATABASE_URL=
PORT=3100
# Email verification: generate a long, random secret and keep it stable.
PCK_OTP_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Stripe Checkout sandbox. Keep secrets in .env only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PCK_PUBLIC_URL=http://127.0.0.1:3100
# Optional when ngrok has no authtoken in its own configuration.
# NGROK_AUTHTOKEN=
